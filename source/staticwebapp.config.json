{
  "routes": [
    {
      "route": "/campus/model/manifest.json",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/campus/model/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/campus/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/campus/photos/*",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/campus/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/campus/sources.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "mimeTypes": {
    ".gz": "application/gzip"
  }
}
