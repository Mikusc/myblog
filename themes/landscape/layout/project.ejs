<%
  var portfolio = site.data.portfolio || {projects:[]};
  var projects = portfolio.projects || [];
  var project = projects.filter(function(p){return p.id === page.project_id;})[0];
%>
<div class="portfolio-page portfolio-detail">
  <a class="portfolio-back" href="<%- url_for('/projects/') %>"><span aria-hidden="true">←</span><span data-zh="返回全部项目" data-en="All projects">返回全部项目</span></a>
  <% if (project) { %>
  <header class="portfolio-detail-heading"><div class="portfolio-card-eyebrow"><span data-zh="<%= project.category.zh %>" data-en="<%= project.category.en %>"><%= project.category.zh %></span><span><%= project.period %></span><span class="portfolio-status" data-zh="<%= project.status.zh %>" data-en="<%= project.status.en %>"><%= project.status.zh %></span></div><h1 data-page-title data-zh="<%= project.title.zh %>" data-en="<%= project.title.en %>"><%= project.title.zh %></h1><p data-zh="<%= project.subtitle.zh %>" data-en="<%= project.subtitle.en %>"><%= project.subtitle.zh %></p><div class="portfolio-actions"><% (project.links || []).forEach(function(link,index){ %><a class="portfolio-button<%= index ? ' portfolio-button-quiet' : '' %>" href="<%- url_for(link.href) %>"<% if (/^https?:/.test(link.href)) { %> target="_blank" rel="noopener noreferrer"<% } %>><span data-zh="<%= link.label.zh %>" data-en="<%= link.label.en %>"><%= link.label.zh %></span><span aria-hidden="true">↗</span></a><% }); %></div></header>
  <% if (project.image) { %><figure class="portfolio-detail-image"><a href="<%- url_for(project.image) %>" target="_blank" rel="noopener" aria-label="查看完整截图" data-aria-zh="查看完整截图" data-aria-en="View full screenshot"><img src="<%- url_for(project.image) %>" alt="<%= (project.imageAlt || project.title).zh %>" data-alt-zh="<%= (project.imageAlt || project.title).zh %>" data-alt-en="<%= (project.imageAlt || project.title).en %>" decoding="async"></a><figcaption data-zh="<%= (project.imageAlt || project.title).zh %>" data-en="<%= (project.imageAlt || project.title).en %>"><%= (project.imageAlt || project.title).zh %></figcaption></figure><% } %>
  <div class="portfolio-case-layout"><div class="portfolio-case-copy"><%
    var sections=[{key:'problem',zh:'要解决的问题',en:'The problem'}, {key:'approach',zh:'我的推进方式与 AI 协作',en:'My process and AI collaboration'}, {key:'outcome',zh:'已有成果',en:'What I delivered'}, {key:'boundary',zh:'当前边界',en:'Current limits'}];
    sections.forEach(function(section,index){var copy=project[section.key];if(!copy) return;
  %><section class="portfolio-case-section"><span class="portfolio-step">0<%= index+1 %></span><div><h2 data-zh="<%= section.zh %>" data-en="<%= section.en %>"><%= section.zh %></h2><p data-zh="<%= copy.zh %>" data-en="<%= copy.en %>"><%= copy.zh %></p></div></section><% }); %></div><aside class="portfolio-case-aside"><h2 data-zh="工具与方法" data-en="Tools & methods">工具与方法</h2><ul class="portfolio-tags"><% (project.tech || []).forEach(function(tech){ %><li><%= tech %></li><% }); %></ul><% if (portfolio.updated) { %><p><span data-zh="页面更新" data-en="Page updated">页面更新</span><br><time><%= portfolio.updated %></time></p><% } %><a class="portfolio-text-link" href="<%- url_for('/contact/') %>"><span data-zh="交流这个项目" data-en="Discuss this project">交流这个项目</span><span aria-hidden="true">↗</span></a></aside></div>
  <% if (page.content && page.content.trim()) { %><div class="portfolio-extra article-entry"><%- page.content %></div><% } %>
  <% } else { %><h1 data-page-title data-zh="项目资料整理中" data-en="Project information in preparation">项目资料整理中</h1><p data-zh="请先浏览项目目录。" data-en="Please explore the project directory.">请先浏览项目目录。</p><% } %>
</div>
