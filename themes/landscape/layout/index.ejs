<%
  var portfolio = site.data.portfolio || {intro:{zh:'',en:''},projects:[]};
  var projects = portfolio.projects || [];
  var featured = projects.filter(function(project){return project.featured;});
  var posts = site.posts && site.posts.toArray ? site.posts.toArray() : [];
  posts.sort(function(a,b){return b.date.valueOf()-a.date.valueOf();});
  var demo = projects.filter(function(project){return project.id === 'ihci';})[0];
%>
<div class="portfolio-page portfolio-home">
  <section class="portfolio-intro">
    <div class="portfolio-intro-copy">
      <p class="portfolio-kicker">MIKUSC · SELECTED WORK</p>
      <h1 data-zh="把想法做成可体验的项目" data-en="Ideas made tangible.">把想法做成可体验的项目</h1>
      <p class="portfolio-intro-text" data-zh="<%= (portfolio.intro || {}).zh || '' %>" data-en="<%= (portfolio.intro || {}).en || '' %>"><%= (portfolio.intro || {}).zh || '' %></p>
      <div class="portfolio-actions">
        <a class="portfolio-button" href="#selected-work"><span data-zh="浏览代表项目" data-en="Explore selected work">浏览代表项目</span><span aria-hidden="true">↓</span></a>
        <a class="portfolio-button portfolio-button-quiet" href="<%- url_for('/about/') %>" data-zh="关于我" data-en="About me">关于我</a>
      </div>
      <p class="portfolio-intro-footnote"><span class="portfolio-accent-dot" aria-hidden="true"></span><span data-zh="AI 应用 · 空间交互 · 内容工作流" data-en="Applied AI · Spatial interaction · Content workflows">AI 应用 · 空间交互 · 内容工作流</span></p>
    </div>
    <% if (demo) { %>
    <a class="portfolio-feature" href="<%- url_for('/projects/ihci/') %>">
      <% if (demo.image) { %><div class="portfolio-feature-media"><span class="portfolio-feature-index" aria-hidden="true">IN FOCUS / 01</span><img src="<%- url_for(demo.image) %>" alt="<%= (demo.imageAlt || demo.title).zh %>" data-alt-zh="<%= (demo.imageAlt || demo.title).zh %>" data-alt-en="<%= (demo.imageAlt || demo.title).en %>" fetchpriority="high" decoding="async"></div><% } else { %><div class="portfolio-feature-pattern" aria-hidden="true"><span>IHCI</span><span>2026</span></div><% } %>
      <div class="portfolio-feature-caption"><div><span class="portfolio-kicker" data-zh="近期项目" data-en="Recent work">近期项目</span><strong data-zh="<%= demo.title.zh %>" data-en="<%= demo.title.en %>"><%= demo.title.zh %></strong></div><span class="portfolio-feature-arrow" aria-hidden="true">↗</span></div>
    </a>
    <% } %>
  </section>

  <section class="portfolio-section" id="selected-work">
    <div class="portfolio-section-head"><div><p class="portfolio-kicker">SELECTED PROJECTS</p><h2 data-zh="从成果进入，了解我如何推进" data-en="Explore the work. See how it was built.">从成果进入，了解我如何推进</h2></div><a class="portfolio-text-link" href="<%- url_for('/projects/') %>"><span data-zh="全部项目" data-en="All projects">全部项目</span><span aria-hidden="true">↗</span></a></div>
    <div class="portfolio-grid"><% featured.forEach(function(project){ %><%- partial('_partial/project-card', {project:project}, {cache:false}) %><% }); %></div>
  </section>

  <section class="portfolio-section portfolio-method">
    <div class="portfolio-section-head"><div><p class="portfolio-kicker">HOW I WORK</p><h2 data-zh="让 AI 参与过程，让结果经得起检查" data-en="AI in the workflow. Evidence in the result.">让 AI 参与过程，让结果经得起检查</h2></div></div>
    <div class="portfolio-method-grid">
      <article><span class="portfolio-step">01</span><h3 data-zh="把问题拆清楚" data-en="Frame the problem">把问题拆清楚</h3><p data-zh="先明确使用场景、约束和交付目标，再选择工具与实现范围。" data-en="Define the use case, constraints, and deliverable before choosing tools and scope.">先明确使用场景、约束和交付目标，再选择工具与实现范围。</p></article>
      <article><span class="portfolio-step">02</span><h3 data-zh="把 AI 接入工作流" data-en="Build an AI-assisted workflow">把 AI 接入工作流</h3><p data-zh="将上下文、任务拆解和反复使用的步骤沉淀为脚本、Skill 与原型。" data-en="Turn context, task breakdowns, and repeatable steps into scripts, Skills, and prototypes.">将上下文、任务拆解和反复使用的步骤沉淀为脚本、Skill 与原型。</p></article>
      <article><span class="portfolio-step">03</span><h3 data-zh="检查后再交付" data-en="Verify before delivery">检查后再交付</h3><p data-zh="结合来源核验、测试、人工审阅和交互预览，记录成果与尚待验证的部分。" data-en="Use source checks, tests, human review, and interaction previews to document results and remaining limits.">结合来源核验、测试、人工审阅和交互预览，记录成果与尚待验证的部分。</p></article>
    </div>
    <% if (portfolio.aiTools && portfolio.aiTools.length) { %><div class="portfolio-tool-row"><span data-zh="常用 AI 协作工具" data-en="My AI toolkit">常用 AI 协作工具</span><ul class="portfolio-tags"><% portfolio.aiTools.forEach(function(tool){ %><li><%= tool %></li><% }); %></ul></div><% } %>
  </section>

  <section class="portfolio-section portfolio-notes">
    <div class="portfolio-section-head"><div><p class="portfolio-kicker">NOTES &amp; EXPLORATIONS</p><h2 data-zh="项目之外，也保留学习过程" data-en="The notes behind the work">项目之外，也保留学习过程</h2></div><a class="portfolio-text-link" href="<%- url_for('/archives/') %>"><span data-zh="文章归档" data-en="Writing archive">文章归档</span><span aria-hidden="true">↗</span></a></div>
    <div class="portfolio-note-layout"><div class="portfolio-note-list"><% posts.slice(0,3).forEach(function(post){ %><a href="<%- url_for(post.path) %>"><time datetime="<%= date(post.date,'YYYY-MM-DD') %>"><%= date(post.date,'YYYY.MM.DD') %></time><strong><%= post.title %></strong><span aria-hidden="true">↗</span></a><% }); %></div><div class="portfolio-note-routes"><a href="<%- url_for('/course-notes/') %>"><strong data-zh="课程笔记" data-en="Course notes">课程笔记</strong><span data-zh="课程复习、算法与练习" data-en="Review guides, algorithms, and exercises">课程复习、算法与练习</span></a><a href="<%- url_for('/tools/') %>"><strong data-zh="工具与独立页面" data-en="Tools and experiments">工具与独立页面</strong><span data-zh="校园导览、实用工具与探索" data-en="Campus guides, utilities, and explorations">校园导览、实用工具与探索</span></a></div></div>
  </section>
</div>
